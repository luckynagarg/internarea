# ============================================================
# Backend environment variables (intern/backend)
# Copy to .env and fill in real values. NEVER commit real secrets.
# ============================================================

# --- MongoDB ---
# NOTE: db.js reads DATABASE_URL (NOT MONGO_URI).
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# --- Server ---
PORT=5000
NODE_ENV=production

# --- Firebase Admin (REQUIRED for protected routes) — choose ONE of the three options below ---
# Option 1: Full service-account JSON string (with escaped \n in private_key)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com",...}

# Option 2: Path to a service-account JSON file (relative to backend root or absolute)
# FIREBASE_SERVICE_ACCOUNT_PATH=./services/<your-firebase-adminsdk-file>.json

# Option 3: Individual vars (private key with escaped \n)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# --- Resend (email) ---
RESEND_API_KEY=re_<your_resend_api_key>
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=InternArea

# --- OTP HMAC secret (used by loginSecurityService, resumeService, otpEmailService) ---
OTP_HMAC_SECRET=<generate-a-long-random-hex-string>

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_<your_key_id>
RAZORPAY_KEY_SECRET=<your_key_secret>
RAZORPAY_CURRENCY=INR
RESUME_PRICE_INR=50

# --- Admin credentials (set strong values in production) ---
ADMIN_USER=admin
ADMIN_PASS=<change-me-in-production>
ADMIN_EMAIL=luckynagar1505@gmail.com
ADMIN_NAME=Admin
# HMAC secret used to issue/verify admin session tokens (>= 32 chars; required).
ADMIN_SESSION_SECRET=<generate-a-long-random-hex-string>

# --- Payment time window (IST) — paid activation only daily 10:00–11:00 ---
# Set ENABLE_PAYMENT_TIME_WINDOW=false to allow paid activation any time.
ENABLE_PAYMENT_TIME_WINDOW=true
PAYMENT_TIMEZONE=Asia/Kolkata
PAYMENT_ALLOWED_START_HOUR_IST=10
PAYMENT_ALLOWED_END_HOUR_IST=11

# --- CORS ---
# FRONTEND_URL or CORS_ORIGIN = single frontend origin
# CORS_ALLOWED_ORIGINS = comma-separated list (takes precedence over defaults)
FRONTEND_URL=https://internarea-one.vercel.app/
# CORS_ORIGIN=https://your-frontend.vercel.app
# CORS_ALLOWED_ORIGINS=https://frontend1.vercel.app,http://localhost:3000

# --- Realtime (Socket.IO) ---
# CORS origins allowed to connect to the Socket.IO server.
# Defaults to FRONTEND_URL if not set.
SOCKET_IO_CORS_ORIGIN=http://localhost:3000

# --- File uploads ---
# Max image size for chat uploads (bytes). Default: 5 MB.
CHAT_MAX_IMAGE_SIZE=5242880
# Directory for uploaded chat images (relative to backend root).
CHAT_UPLOAD_DIR=uploads/chat-images

# --- Supabase Storage (profile images / post media) ---
# Server-side ONLY. NEVER expose these to the browser (no NEXT_PUBLIC_ prefix,
# never add to Vercel, never return in API responses).
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-or-secret-key>
# Bucket "profile-images" is created automatically on first upload (public read,
# writes only via the backend service key).

# ===== Firebase Admin (REQUIRED for protected routes) =====
# Provided above in the Firebase Admin section above. Do NOT duplicate here.
